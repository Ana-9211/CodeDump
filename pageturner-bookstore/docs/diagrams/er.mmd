    ROLES { smallint role_id PK
            varchar role_name UK }
    USERS { bigint user_id PK
            citext email UK
            text password_hash
            smallint role_id FK
            varchar status
            int failed_login_count
            timestamptz locked_until }
    SELLER_PROFILES { bigint user_id PK, FK
            varchar store_name UK }
    SELLER_APPLICATIONS { bigint application_id PK
            bigint user_id FK
            varchar store_name
            varchar status }
    ADDRESSES { bigint address_id PK
            bigint user_id FK
            varchar postal_code
            boolean is_default }
    CATEGORIES { int category_id PK
            varchar name
            int parent_id FK }
    AUTHORS { int author_id PK
            varchar name UK }
    BOOKS { bigint book_id PK
            bigint seller_id FK
            int category_id FK
            varchar isbn
            int price_cents
            int stock
            varchar status
            numeric avg_rating
            tsvector search_vector }
    BOOK_AUTHORS { bigint book_id PK, FK
            int author_id PK, FK
            smallint author_order }
    CART_ITEMS { bigint user_id PK, FK
            bigint book_id PK, FK
            int quantity }
    WISHLIST_ITEMS { bigint user_id PK, FK
            bigint book_id PK, FK }
    ORDERS { bigint order_id PK
            varchar order_number UK
            bigint user_id FK
            varchar status
            int total_cents
            text ship_line1 }
    ORDER_ITEMS { bigint order_item_id PK
            bigint order_id FK
            bigint book_id FK
            bigint seller_id FK
            int quantity
            int unit_price_cents
            varchar fulfilment_status }
    PAYMENTS { bigint payment_id PK
            bigint order_id FK
            varchar method
            varchar status }
    STOCK_MOVEMENTS { bigint movement_id PK
            bigint book_id FK
            int delta
            varchar reason }
    NOTIFICATIONS { bigint notification_id PK
            bigint user_id FK
            varchar kind
            timestamptz read_at }
    PASSWORD_RESETS { char token_hash PK
            bigint user_id FK
            timestamptz expires_at }
    AUDIT_LOG { bigint audit_id PK
            varchar table_name
            jsonb old_data
            jsonb new_data }
    APP_SETTINGS { varchar setting_key PK
            int setting_value }
