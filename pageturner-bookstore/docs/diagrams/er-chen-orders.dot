  a35 [shape=ellipse, label=<paid_at>, fillcolor="#ffffff", style="filled", fontsize=10, margin="0.06,0.03"];
  e_payment -- a35 [len=1.15, penwidth=1];
  e_move [shape=box, label="Stock Movement", fillcolor="#e8f1ec", style="filled", fontsize=13, fontname="Arial Bold", margin="0.22,0.12", penwidth=1.6];
  a36 [shape=ellipse, label=<<U>movement_id</U>>, fillcolor="#ffffff", style="filled", fontsize=10, margin="0.06,0.03"];
  e_move -- a36 [len=1.15, penwidth=1];
  a37 [shape=ellipse, label=<delta>, fillcolor="#ffffff", style="filled", fontsize=10, margin="0.06,0.03"];
  e_move -- a37 [len=1.15, penwidth=1];
  a38 [shape=ellipse, label=<reason>, fillcolor="#ffffff", style="filled", fontsize=10, margin="0.06,0.03"];
  e_move -- a38 [len=1.15, penwidth=1];
  a39 [shape=ellipse, label=<created_by>, fillcolor="#ffffff", style="filled", fontsize=10, margin="0.06,0.03"];
  e_move -- a39 [len=1.15, penwidth=1];
  a40 [shape=ellipse, label=<created_at>, fillcolor="#ffffff", style="filled", fontsize=10, margin="0.06,0.03"];
  e_move -- a40 [len=1.15, penwidth=1];
  e_user [shape=box, label="User", fillcolor="#e8f1ec", style="filled,dashed", fontsize=13, fontname="Arial Bold", margin="0.22,0.12", penwidth=1.6];
  a41 [shape=ellipse, label=<<U>user_id</U>>, fillcolor="#ffffff", style="filled", fontsize=10, margin="0.06,0.03"];
  e_user -- a41 [len=1.15, penwidth=1];
  e_book [shape=box, label="Book", fillcolor="#e8f1ec", style="filled,dashed", fontsize=13, fontname="Arial Bold", margin="0.22,0.12", penwidth=1.6];
  a42 [shape=ellipse, label=<<U>book_id</U>>, fillcolor="#ffffff", style="filled", fontsize=10, margin="0.06,0.03"];
  e_book -- a42 [len=1.15, penwidth=1];
  r_cart [shape=diamond, label="Adds To Cart", fillcolor="#e2eef5", style=filled, fontsize=11, fontname="Arial Bold", margin="0.04,0.02", penwidth=1.4];
  r_cart -- e_user [len=2.0, penwidth=1.2, color=black, headlabel=<<B>M</B>>, labeldistance=2.6, labelangle=0, fontsize=12, fontname="Arial"];
  r_cart -- e_book [len=2.0, penwidth=1.2, color=black, headlabel=<<B>N</B>>, labeldistance=2.6, labelangle=0, fontsize=12, fontname="Arial"];
  a43 [shape=ellipse, label=<quantity>, fillcolor="#fffdf8", style="filled", fontsize=10, margin="0.06,0.03"];
  r_cart -- a43 [len=1.0, penwidth=1];
  a44 [shape=ellipse, label=<added_at>, fillcolor="#fffdf8", style="filled", fontsize=10, margin="0.06,0.03"];
  r_cart -- a44 [len=1.0, penwidth=1];
  r_places [shape=diamond, label="Places", fillcolor="#e2eef5", style=filled, fontsize=11, fontname="Arial Bold", margin="0.04,0.02", penwidth=1.4];
  r_places -- e_user [len=2.0, penwidth=1.2, color=black, headlabel=<<B>1</B>>, labeldistance=2.6, labelangle=0, fontsize=12, fontname="Arial"];
  r_places -- e_order [len=2.0, penwidth=1.3, color="black:white:black", headlabel=<<B>N</B>>, labeldistance=2.6, labelangle=0, fontsize=12, fontname="Arial"];
  r_contains [shape=diamond, label="Contains", fillcolor="#e2eef5", style=filled, peripheries=2, fontsize=11, fontname="Arial Bold", margin="0.04,0.02", penwidth=1.4];
  r_contains -- e_order [len=2.0, penwidth=1.2, color=black, headlabel=<<B>1</B>>, labeldistance=2.6, labelangle=0, fontsize=12, fontname="Arial"];
  r_contains -- e_item [len=2.0, penwidth=1.3, color="black:white:black", headlabel=<<B>N</B>>, labeldistance=2.6, labelangle=0, fontsize=12, fontname="Arial"];
  r_refers [shape=diamond, label="Refers To", fillcolor="#e2eef5", style=filled, fontsize=11, fontname="Arial Bold", margin="0.04,0.02", penwidth=1.4];
  r_refers -- e_item [len=2.0, penwidth=1.3, color="black:white:black", headlabel=<<B>N</B>>, labeldistance=2.6, labelangle=0, fontsize=12, fontname="Arial"];
  r_refers -- e_book [len=2.0, penwidth=1.2, color=black, headlabel=<<B>1</B>>, labeldistance=2.6, labelangle=0, fontsize=12, fontname="Arial"];
  r_fulfils [shape=diamond, label="Fulfilled By", fillcolor="#e2eef5", style=filled, fontsize=11, fontname="Arial Bold", margin="0.04,0.02", penwidth=1.4];
  r_fulfils -- e_item [len=2.0, penwidth=1.3, color="black:white:black", headlabel=<<B>N</B>>, labeldistance=2.6, labelangle=0, fontsize=12, fontname="Arial"];
  r_fulfils -- e_user [len=2.0, penwidth=1.2, color=black, headlabel=<<B>1</B><BR/><I>seller</I>>, labeldistance=2.6, labelangle=40, fontsize=12, fontname="Arial"];
  r_settled [shape=diamond, label="Settled By", fillcolor="#e2eef5", style=filled, peripheries=2, fontsize=11, fontname="Arial Bold", margin="0.04,0.02", penwidth=1.4];
  r_settled -- e_order [len=2.0, penwidth=1.2, color=black, headlabel=<<B>1</B>>, labeldistance=2.6, labelangle=0, fontsize=12, fontname="Arial"];
  r_settled -- e_payment [len=2.0, penwidth=1.3, color="black:white:black", headlabel=<<B>1</B>>, labeldistance=2.6, labelangle=0, fontsize=12, fontname="Arial"];
  r_moves [shape=diamond, label="Moves Stock Of", fillcolor="#e2eef5", style=filled, fontsize=11, fontname="Arial Bold", margin="0.04,0.02", penwidth=1.4];
  r_moves -- e_book [len=2.0, penwidth=1.2, color=black, headlabel=<<B>1</B>>, labeldistance=2.6, labelangle=0, fontsize=12, fontname="Arial"];
  r_moves -- e_move [len=2.0, penwidth=1.3, color="black:white:black", headlabel=<<B>N</B>>, labeldistance=2.6, labelangle=0, fontsize=12, fontname="Arial"];
  r_causedby [shape=diamond, label="Caused By", fillcolor="#e2eef5", style=filled, fontsize=11, fontname="Arial Bold", margin="0.04,0.02", penwidth=1.4];
  r_causedby -- e_move [len=2.0, penwidth=1.2, color=black, headlabel=<<B>N</B>>, labeldistance=2.6, labelangle=0, fontsize=12, fontname="Arial"];
