  a24 [shape=ellipse, label=<unit_price_cents>, fillcolor="#ffffff", style="filled", fontsize=10, margin="0.06,0.03"];
  e_item -- a24 [len=1.15, penwidth=1];
  a25 [shape=ellipse, label=<quantity>, fillcolor="#ffffff", style="filled", fontsize=10, margin="0.06,0.03"];
