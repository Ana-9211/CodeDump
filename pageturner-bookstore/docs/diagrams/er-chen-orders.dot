  a27 [shape=ellipse, label=<fulfilment_status>, fillcolor="#ffffff", style="filled", fontsize=10, margin="0.06,0.03"];
  e_item -- a27 [len=1.15, penwidth=1];
  a28 [shape=ellipse, label=<updated_at>, fillcolor="#ffffff", style="filled", fontsize=10, margin="0.06,0.03"];
