graph "er-chen-orders" {
  layout=neato; overlap=prism; overlap_scaling=2.2; sep="+26"; splines=true; mode=major; start=7;
  labelloc=t; label=<<B>PageTurner ER (Chen): cart, orders, payments and stock</B>>; fontsize=22; fontname="Arial"; pad=0.4;
  node [fontname="Arial", fontcolor="#1f2a2e", color="#1f2a2e"]; edge [color="#1f2a2e"];
  e_order [shape=box, label="Order", fillcolor="#e8f1ec", style="filled", fontsize=13, fontname="Arial Bold", margin="0.22,0.12", penwidth=1.6];
  a1 [shape=ellipse, label=<<U>order_id</U>>, fillcolor="#ffffff", style="filled", fontsize=10, margin="0.06,0.03"];
  e_order -- a1 [len=1.15, penwidth=1];
  a2 [shape=ellipse, label=<order_number>, fillcolor="#ffffff", style="filled", fontsize=10, margin="0.06,0.03"];
  e_order -- a2 [len=1.15, penwidth=1];
  a3 [shape=ellipse, label=<status>, fillcolor="#ffffff", style="filled", fontsize=10, margin="0.06,0.03"];
  e_order -- a3 [len=1.15, penwidth=1];
  a4 [shape=ellipse, label=<shipping address (snapshot)>, fillcolor="#ffffff", style="filled", fontsize=10, margin="0.06,0.03"];
  e_order -- a4 [len=1.15, penwidth=1];
  a5 [shape=ellipse, label="ship_full_name", fillcolor="#ffffff", style=filled, fontsize=9, margin="0.05,0.02"];
  a4 -- a5 [len=0.9, penwidth=1];
  a6 [shape=ellipse, label="ship_line1", fillcolor="#ffffff", style=filled, fontsize=9, margin="0.05,0.02"];
  a4 -- a6 [len=0.9, penwidth=1];
  a7 [shape=ellipse, label="ship_line2", fillcolor="#ffffff", style=filled, fontsize=9, margin="0.05,0.02"];
  a4 -- a7 [len=0.9, penwidth=1];
  a8 [shape=ellipse, label="ship_city", fillcolor="#ffffff", style=filled, fontsize=9, margin="0.05,0.02"];
  a4 -- a8 [len=0.9, penwidth=1];
  a9 [shape=ellipse, label="ship_state", fillcolor="#ffffff", style=filled, fontsize=9, margin="0.05,0.02"];
  a4 -- a9 [len=0.9, penwidth=1];
  a10 [shape=ellipse, label="ship_postal_code", fillcolor="#ffffff", style=filled, fontsize=9, margin="0.05,0.02"];
  a4 -- a10 [len=0.9, penwidth=1];
  a11 [shape=ellipse, label="ship_country", fillcolor="#ffffff", style=filled, fontsize=9, margin="0.05,0.02"];
  a4 -- a11 [len=0.9, penwidth=1];
  a12 [shape=ellipse, label="ship_phone", fillcolor="#ffffff", style=filled, fontsize=9, margin="0.05,0.02"];
  a4 -- a12 [len=0.9, penwidth=1];
  a13 [shape=ellipse, label=<subtotal_cents>, fillcolor="#ffffff", style="filled", fontsize=10, margin="0.06,0.03"];
  e_order -- a13 [len=1.15, penwidth=1];
  a14 [shape=ellipse, label=<tax_cents>, fillcolor="#ffffff", style="filled", fontsize=10, margin="0.06,0.03"];
  e_order -- a14 [len=1.15, penwidth=1];
  a15 [shape=ellipse, label=<shipping_cents>, fillcolor="#ffffff", style="filled", fontsize=10, margin="0.06,0.03"];
  e_order -- a15 [len=1.15, penwidth=1];
  a16 [shape=ellipse, label=<total_cents>, fillcolor="#ffffff", style="filled,dashed", fontsize=10, margin="0.06,0.03"];
  e_order -- a16 [len=1.15, penwidth=1];
  a17 [shape=ellipse, label=<placed_at>, fillcolor="#ffffff", style="filled", fontsize=10, margin="0.06,0.03"];
  e_order -- a17 [len=1.15, penwidth=1];
  a18 [shape=ellipse, label=<cancelled_at>, fillcolor="#ffffff", style="filled", fontsize=10, margin="0.06,0.03"];
  e_order -- a18 [len=1.15, penwidth=1];
  a19 [shape=ellipse, label=<created_at>, fillcolor="#ffffff", style="filled", fontsize=10, margin="0.06,0.03"];
  e_order -- a19 [len=1.15, penwidth=1];
  a20 [shape=ellipse, label=<updated_at>, fillcolor="#ffffff", style="filled", fontsize=10, margin="0.06,0.03"];
  e_order -- a20 [len=1.15, penwidth=1];
  e_item [shape=box, label="Order Item", fillcolor="#fbefd9", style="filled", peripheries=2, fontsize=13, fontname="Arial Bold", margin="0.22,0.12", penwidth=1.6];
  a21 [shape=ellipse, label=<<I><U>order_item_id</U></I>>, fillcolor="#ffffff", style="filled", fontsize=10, margin="0.06,0.03"];
