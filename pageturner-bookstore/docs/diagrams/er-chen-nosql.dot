graph "er-chen-nosql" {
  layout=neato; overlap=prism; overlap_scaling=2.2; sep="+26"; splines=true; mode=major; start=7;
  labelloc=t; label=<<B>MongoDB (NoSQL, linked by book_id and user_id): not part of the relational ER</B>>; fontsize=22; fontname="Arial"; pad=0.4;
  node [fontname="Arial", fontcolor="#1f2a2e", color="#1f2a2e"]; edge [color="#1f2a2e"];
  subgraph cluster_mongo { label=<<B>MongoDB database bookstore_nosql</B>>; style="dashed,filled"; fillcolor="#f8f1fb"; fontsize=14; color="#7a4e9c"; penwidth=2;
  e_review [shape=box, label="Review (document)", fillcolor="#f1e6f5", style="filled", fontsize=13, fontname="Arial Bold", margin="0.22,0.12", penwidth=1.6];
  a1 [shape=ellipse, label=<<U>_id</U>>, fillcolor="#ffffff", style="filled", fontsize=10, margin="0.06,0.03"];
  e_review -- a1 [len=1.15, penwidth=1];
  a2 [shape=ellipse, label=<bookId>, fillcolor="#ffffff", style="filled", fontsize=10, margin="0.06,0.03"];
  e_review -- a2 [len=1.15, penwidth=1];
  a3 [shape=ellipse, label=<userId>, fillcolor="#ffffff", style="filled", fontsize=10, margin="0.06,0.03"];
  e_review -- a3 [len=1.15, penwidth=1];
  a4 [shape=ellipse, label=<userName>, fillcolor="#ffffff", style="filled", fontsize=10, margin="0.06,0.03"];
  e_review -- a4 [len=1.15, penwidth=1];
  a5 [shape=ellipse, label=<rating>, fillcolor="#ffffff", style="filled", fontsize=10, margin="0.06,0.03"];
  e_review -- a5 [len=1.15, penwidth=1];
  a6 [shape=ellipse, label=<title>, fillcolor="#ffffff", style="filled", fontsize=10, margin="0.06,0.03"];
  e_review -- a6 [len=1.15, penwidth=1];
  a7 [shape=ellipse, label=<body>, fillcolor="#ffffff", style="filled", fontsize=10, margin="0.06,0.03"];
  e_review -- a7 [len=1.15, penwidth=1];
  a8 [shape=ellipse, label=<helpfulBy>, fillcolor="#ffffff", style="filled", peripheries=2, fontsize=10, margin="0.06,0.03"];
  e_review -- a8 [len=1.15, penwidth=1];
  a9 [shape=ellipse, label=<helpfulCount>, fillcolor="#ffffff", style="filled,dashed", fontsize=10, margin="0.06,0.03"];
  e_review -- a9 [len=1.15, penwidth=1];
  a10 [shape=ellipse, label=<createdAt>, fillcolor="#ffffff", style="filled", fontsize=10, margin="0.06,0.03"];
  e_review -- a10 [len=1.15, penwidth=1];
  a11 [shape=ellipse, label=<updatedAt>, fillcolor="#ffffff", style="filled", fontsize=10, margin="0.06,0.03"];
  e_review -- a11 [len=1.15, penwidth=1];
  e_view [shape=box, label="Book View (event)", fillcolor="#f1e6f5", style="filled", fontsize=13, fontname="Arial Bold", margin="0.22,0.12", penwidth=1.6];
  a12 [shape=ellipse, label=<<U>_id</U>>, fillcolor="#ffffff", style="filled", fontsize=10, margin="0.06,0.03"];
  e_view -- a12 [len=1.15, penwidth=1];
  a13 [shape=ellipse, label=<bookId>, fillcolor="#ffffff", style="filled", fontsize=10, margin="0.06,0.03"];
  e_view -- a13 [len=1.15, penwidth=1];
  a14 [shape=ellipse, label=<userId>, fillcolor="#ffffff", style="filled", fontsize=10, margin="0.06,0.03"];
  e_view -- a14 [len=1.15, penwidth=1];
  a15 [shape=ellipse, label=<at>, fillcolor="#ffffff", style="filled", fontsize=10, margin="0.06,0.03"];
  e_view -- a15 [len=1.15, penwidth=1];
  }
  e_user [shape=box, label="User (PostgreSQL)", fillcolor="#e8f1ec", style="filled,dashed", fontsize=13, fontname="Arial Bold", margin="0.22,0.12", penwidth=1.6];
  a16 [shape=ellipse, label=<<U>user_id</U>>, fillcolor="#ffffff", style="filled", fontsize=10, margin="0.06,0.03"];
  e_user -- a16 [len=1.15, penwidth=1];
  e_book [shape=box, label="Book (PostgreSQL)", fillcolor="#e8f1ec", style="filled,dashed", fontsize=13, fontname="Arial Bold", margin="0.22,0.12", penwidth=1.6];
  a17 [shape=ellipse, label=<<U>book_id</U>>, fillcolor="#ffffff", style="filled", fontsize=10, margin="0.06,0.03"];
  e_book -- a17 [len=1.15, penwidth=1];
  r_writes [shape=diamond, label="Writes", fillcolor="#e2eef5", style=filled, fontsize=11, fontname="Arial Bold", margin="0.04,0.02", penwidth=1.4];
  r_writes -- e_user [len=2.0, penwidth=1.2, color=black, headlabel=<<B>1</B>>, labeldistance=2.6, labelangle=0, fontsize=12, fontname="Arial"];
  r_writes -- e_review [len=2.0, penwidth=1.3, color="black:white:black", headlabel=<<B>N</B>>, labeldistance=2.6, labelangle=0, fontsize=12, fontname="Arial"];
  r_reviewed [shape=diamond, label="Is Reviewed In", fillcolor="#e2eef5", style=filled, fontsize=11, fontname="Arial Bold", margin="0.04,0.02", penwidth=1.4];
  r_reviewed -- e_book [len=2.0, penwidth=1.2, color=black, headlabel=<<B>1</B>>, labeldistance=2.6, labelangle=0, fontsize=12, fontname="Arial"];
  r_reviewed -- e_review [len=2.0, penwidth=1.3, color="black:white:black", headlabel=<<B>N</B>>, labeldistance=2.6, labelangle=0, fontsize=12, fontname="Arial"];
  r_viewedby [shape=diamond, label="Views", fillcolor="#e2eef5", style=filled, fontsize=11, fontname="Arial Bold", margin="0.04,0.02", penwidth=1.4];
  r_viewedby -- e_user [len=2.0, penwidth=1.2, color=black, headlabel=<<B>1</B>>, labeldistance=2.6, labelangle=0, fontsize=12, fontname="Arial"];
  r_viewedby -- e_view [len=2.0, penwidth=1.2, color=black, headlabel=<<B>N</B>>, labeldistance=2.6, labelangle=0, fontsize=12, fontname="Arial"];
  r_viewed [shape=diamond, label="Is Viewed In", fillcolor="#e2eef5", style=filled, fontsize=11, fontname="Arial Bold", margin="0.04,0.02", penwidth=1.4];
  r_viewed -- e_book [len=2.0, penwidth=1.2, color=black, headlabel=<<B>1</B>>, labeldistance=2.6, labelangle=0, fontsize=12, fontname="Arial"];
  r_viewed -- e_view [len=2.0, penwidth=1.3, color="black:white:black", headlabel=<<B>N</B>>, labeldistance=2.6, labelangle=0, fontsize=12, fontname="Arial"];
  legend [shape=note, fontsize=10, fillcolor="#fffdf8", style=filled, label="The links are values only (bookId, userId):\nno foreign key crosses the two databases.\nbooks.avg_rating and review_count in PostgreSQL\nare a cached summary of these reviews.\nView events expire after 30 days (TTL index)."];
  legend -- e_review [style=dotted, len=1.5];
}
