graph "er-chen-other" {
  layout=neato; overlap=prism; overlap_scaling=2.2; sep="+26"; splines=true; mode=major; start=7;
  labelloc=t; label=<<B>PageTurner ER (Chen): wishlist, audit log and settings</B>>; fontsize=22; fontname="Arial"; pad=0.4;
  node [fontname="Arial", fontcolor="#1f2a2e", color="#1f2a2e"]; edge [color="#1f2a2e"];
  e_user [shape=box, label="User", fillcolor="#e8f1ec", style="filled,dashed", fontsize=13, fontname="Arial Bold", margin="0.22,0.12", penwidth=1.6];
  a1 [shape=ellipse, label=<<U>user_id</U>>, fillcolor="#ffffff", style="filled", fontsize=10, margin="0.06,0.03"];
  e_user -- a1 [len=1.15, penwidth=1];
  e_book [shape=box, label="Book", fillcolor="#e8f1ec", style="filled,dashed", fontsize=13, fontname="Arial Bold", margin="0.22,0.12", penwidth=1.6];
  a2 [shape=ellipse, label=<<U>book_id</U>>, fillcolor="#ffffff", style="filled", fontsize=10, margin="0.06,0.03"];
  e_book -- a2 [len=1.15, penwidth=1];
  r_wish [shape=diamond, label="Saves To Wishlist", fillcolor="#e2eef5", style=filled, fontsize=11, fontname="Arial Bold", margin="0.04,0.02", penwidth=1.4];
  r_wish -- e_user [len=2.0, penwidth=1.2, color=black, headlabel=<<B>M</B>>, labeldistance=2.6, labelangle=0, fontsize=12, fontname="Arial"];
  r_wish -- e_book [len=2.0, penwidth=1.2, color=black, headlabel=<<B>N</B>>, labeldistance=2.6, labelangle=0, fontsize=12, fontname="Arial"];
  a3 [shape=ellipse, label=<added_at>, fillcolor="#fffdf8", style="filled", fontsize=10, margin="0.06,0.03"];
  r_wish -- a3 [len=1.0, penwidth=1];
  e_audit [shape=box, label="Audit Log", fillcolor="#e8f1ec", style="filled", fontsize=13, fontname="Arial Bold", margin="0.22,0.12", penwidth=1.6];
  a4 [shape=ellipse, label=<<U>audit_id</U>>, fillcolor="#ffffff", style="filled", fontsize=10, margin="0.06,0.03"];
  e_audit -- a4 [len=1.15, penwidth=1];
  a5 [shape=ellipse, label=<table_name>, fillcolor="#ffffff", style="filled", fontsize=10, margin="0.06,0.03"];
  e_audit -- a5 [len=1.15, penwidth=1];
  a6 [shape=ellipse, label=<record_id>, fillcolor="#ffffff", style="filled", fontsize=10, margin="0.06,0.03"];
  e_audit -- a6 [len=1.15, penwidth=1];
  a7 [shape=ellipse, label=<action>, fillcolor="#ffffff", style="filled", fontsize=10, margin="0.06,0.03"];
  e_audit -- a7 [len=1.15, penwidth=1];
  a8 [shape=ellipse, label=<old_data>, fillcolor="#ffffff", style="filled", fontsize=10, margin="0.06,0.03"];
  e_audit -- a8 [len=1.15, penwidth=1];
  a9 [shape=ellipse, label=<new_data>, fillcolor="#ffffff", style="filled", fontsize=10, margin="0.06,0.03"];
  e_audit -- a9 [len=1.15, penwidth=1];
  a10 [shape=ellipse, label=<actor_id>, fillcolor="#ffffff", style="filled", fontsize=10, margin="0.06,0.03"];
  e_audit -- a10 [len=1.15, penwidth=1];
  a11 [shape=ellipse, label=<changed_at>, fillcolor="#ffffff", style="filled", fontsize=10, margin="0.06,0.03"];
  e_audit -- a11 [len=1.15, penwidth=1];
  e_setting [shape=box, label="App Setting", fillcolor="#e8f1ec", style="filled", fontsize=13, fontname="Arial Bold", margin="0.22,0.12", penwidth=1.6];
  a12 [shape=ellipse, label=<<U>setting_key</U>>, fillcolor="#ffffff", style="filled", fontsize=10, margin="0.06,0.03"];
  e_setting -- a12 [len=1.15, penwidth=1];
  a13 [shape=ellipse, label=<setting_value>, fillcolor="#ffffff", style="filled", fontsize=10, margin="0.06,0.03"];
  e_setting -- a13 [len=1.15, penwidth=1];
  a14 [shape=ellipse, label=<description>, fillcolor="#ffffff", style="filled", fontsize=10, margin="0.06,0.03"];
  e_setting -- a14 [len=1.15, penwidth=1];
  note_audit [shape=note, fontsize=10, fillcolor="#fffdf8", style=filled, label="Written by triggers.\nrecord_id and actor_id are plain numbers,\nnot foreign keys, so the log\nsurvives deletes."];
  note_audit -- e_audit [style=dotted, len=1.2];
  note_set [shape=note, fontsize=10, fillcolor="#fffdf8", style=filled, label="Business rules as data\n(tax rate, shipping fee,\nlogin lock-out)."];
  note_set -- e_setting [style=dotted, len=1.2];
}
