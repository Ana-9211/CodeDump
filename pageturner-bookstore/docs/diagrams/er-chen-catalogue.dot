graph "er-chen-catalogue" {
  layout=neato; overlap=prism; overlap_scaling=2.2; sep="+26"; splines=true; mode=major; start=7;
  labelloc=t; label=<<B>PageTurner ER (Chen): catalogue, categories and authors</B>>; fontsize=22; fontname="Arial"; pad=0.4;
  node [fontname="Arial", fontcolor="#1f2a2e", color="#1f2a2e"]; edge [color="#1f2a2e"];
  e_book [shape=box, label="Book", fillcolor="#e8f1ec", style="filled", fontsize=13, fontname="Arial Bold", margin="0.22,0.12", penwidth=1.6];
  a1 [shape=ellipse, label=<<U>book_id</U>>, fillcolor="#ffffff", style="filled", fontsize=10, margin="0.06,0.03"];
  e_book -- a1 [len=1.15, penwidth=1];
  a2 [shape=ellipse, label=<isbn>, fillcolor="#ffffff", style="filled", fontsize=10, margin="0.06,0.03"];
  e_book -- a2 [len=1.15, penwidth=1];
  a3 [shape=ellipse, label=<title>, fillcolor="#ffffff", style="filled", fontsize=10, margin="0.06,0.03"];
  e_book -- a3 [len=1.15, penwidth=1];
  a4 [shape=ellipse, label=<description>, fillcolor="#ffffff", style="filled", fontsize=10, margin="0.06,0.03"];
  e_book -- a4 [len=1.15, penwidth=1];
  a5 [shape=ellipse, label=<language>, fillcolor="#ffffff", style="filled", fontsize=10, margin="0.06,0.03"];
  e_book -- a5 [len=1.15, penwidth=1];
  a6 [shape=ellipse, label=<cover_url>, fillcolor="#ffffff", style="filled", fontsize=10, margin="0.06,0.03"];
  e_book -- a6 [len=1.15, penwidth=1];
  a7 [shape=ellipse, label=<price_cents>, fillcolor="#ffffff", style="filled", fontsize=10, margin="0.06,0.03"];
  e_book -- a7 [len=1.15, penwidth=1];
  a8 [shape=ellipse, label=<stock>, fillcolor="#ffffff", style="filled", fontsize=10, margin="0.06,0.03"];
  e_book -- a8 [len=1.15, penwidth=1];
  a9 [shape=ellipse, label=<low_stock_threshold>, fillcolor="#ffffff", style="filled", fontsize=10, margin="0.06,0.03"];
  e_book -- a9 [len=1.15, penwidth=1];
  a10 [shape=ellipse, label=<status>, fillcolor="#ffffff", style="filled", fontsize=10, margin="0.06,0.03"];
  e_book -- a10 [len=1.15, penwidth=1];
  a11 [shape=ellipse, label=<rejection_reason>, fillcolor="#ffffff", style="filled", fontsize=10, margin="0.06,0.03"];
  e_book -- a11 [len=1.15, penwidth=1];
  a12 [shape=ellipse, label=<avg_rating>, fillcolor="#ffffff", style="filled,dashed", fontsize=10, margin="0.06,0.03"];
  e_book -- a12 [len=1.15, penwidth=1];
  a13 [shape=ellipse, label=<review_count>, fillcolor="#ffffff", style="filled,dashed", fontsize=10, margin="0.06,0.03"];
  e_book -- a13 [len=1.15, penwidth=1];
  a14 [shape=ellipse, label=<search_vector>, fillcolor="#ffffff", style="filled,dashed", fontsize=10, margin="0.06,0.03"];
  e_book -- a14 [len=1.15, penwidth=1];
  a15 [shape=ellipse, label=<created_at>, fillcolor="#ffffff", style="filled", fontsize=10, margin="0.06,0.03"];
  e_book -- a15 [len=1.15, penwidth=1];
  a16 [shape=ellipse, label=<updated_at>, fillcolor="#ffffff", style="filled", fontsize=10, margin="0.06,0.03"];
  e_book -- a16 [len=1.15, penwidth=1];
  e_category [shape=box, label="Category", fillcolor="#e8f1ec", style="filled", fontsize=13, fontname="Arial Bold", margin="0.22,0.12", penwidth=1.6];
  a17 [shape=ellipse, label=<<U>category_id</U>>, fillcolor="#ffffff", style="filled", fontsize=10, margin="0.06,0.03"];
  e_category -- a17 [len=1.15, penwidth=1];
  a18 [shape=ellipse, label=<name>, fillcolor="#ffffff", style="filled", fontsize=10, margin="0.06,0.03"];
  e_category -- a18 [len=1.15, penwidth=1];
  e_author [shape=box, label="Author", fillcolor="#e8f1ec", style="filled", fontsize=13, fontname="Arial Bold", margin="0.22,0.12", penwidth=1.6];
  a19 [shape=ellipse, label=<<U>author_id</U>>, fillcolor="#ffffff", style="filled", fontsize=10, margin="0.06,0.03"];
  e_author -- a19 [len=1.15, penwidth=1];
  a20 [shape=ellipse, label=<name>, fillcolor="#ffffff", style="filled", fontsize=10, margin="0.06,0.03"];
  e_author -- a20 [len=1.15, penwidth=1];
  e_user [shape=box, label="User (seller)", fillcolor="#e8f1ec", style="filled,dashed", fontsize=13, fontname="Arial Bold", margin="0.22,0.12", penwidth=1.6];
  a21 [shape=ellipse, label=<<U>user_id</U>>, fillcolor="#ffffff", style="filled", fontsize=10, margin="0.06,0.03"];
  e_user -- a21 [len=1.15, penwidth=1];
  r_sells [shape=diamond, label="Sells", fillcolor="#e2eef5", style=filled, fontsize=11, fontname="Arial Bold", margin="0.04,0.02", penwidth=1.4];
  r_sells -- e_user [len=2.0, penwidth=1.2, color=black, headlabel=<<B>1</B>>, labeldistance=2.6, labelangle=0, fontsize=12, fontname="Arial"];
  r_sells -- e_book [len=2.0, penwidth=1.3, color="black:white:black", headlabel=<<B>N</B>>, labeldistance=2.6, labelangle=0, fontsize=12, fontname="Arial"];
  r_belongs [shape=diamond, label="Belongs To", fillcolor="#e2eef5", style=filled, fontsize=11, fontname="Arial Bold", margin="0.04,0.02", penwidth=1.4];
  r_belongs -- e_category [len=2.0, penwidth=1.2, color=black, headlabel=<<B>1</B>>, labeldistance=2.6, labelangle=0, fontsize=12, fontname="Arial"];
  r_belongs -- e_book [len=2.0, penwidth=1.3, color="black:white:black", headlabel=<<B>N</B>>, labeldistance=2.6, labelangle=0, fontsize=12, fontname="Arial"];
  r_parent [shape=diamond, label="Parent Of", fillcolor="#e2eef5", style=filled, fontsize=11, fontname="Arial Bold", margin="0.04,0.02", penwidth=1.4];
  r_parent -- e_category [len=2.0, penwidth=1.2, color=black, headlabel=<<B>1</B><BR/><I>parent</I>>, labeldistance=2.6, labelangle=-50, fontsize=12, fontname="Arial"];
  r_parent -- e_category [len=2.0, penwidth=1.2, color=black, headlabel=<<B>N</B><BR/><I>child</I>>, labeldistance=2.6, labelangle=50, fontsize=12, fontname="Arial"];
  r_writtenby [shape=diamond, label="Written By", fillcolor="#e2eef5", style=filled, fontsize=11, fontname="Arial Bold", margin="0.04,0.02", penwidth=1.4];
  r_writtenby -- e_book [len=2.0, penwidth=1.2, color=black, headlabel=<<B>M</B>>, labeldistance=2.6, labelangle=0, fontsize=12, fontname="Arial"];
  r_writtenby -- e_author [len=2.0, penwidth=1.2, color=black, headlabel=<<B>N</B>>, labeldistance=2.6, labelangle=0, fontsize=12, fontname="Arial"];
  a22 [shape=ellipse, label=<author_order>, fillcolor="#fffdf8", style="filled", fontsize=10, margin="0.06,0.03"];
  r_writtenby -- a22 [len=1.0, penwidth=1];
}
