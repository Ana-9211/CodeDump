graph "er-chen-overview" {
  layout=neato; overlap=prism; overlap_scaling=2.2; sep="+30"; splines=true; mode=major; start=7;
  labelloc=t; label=<<B>PageTurner ER (Chen): overview, entities and relationships with key attributes only</B>>; fontsize=22; fontname="Arial"; pad=0.4;
  node [fontname="Arial", fontcolor="#1f2a2e", color="#1f2a2e"]; edge [color="#1f2a2e"];
  e_user [shape=box, label="User", fillcolor="#e8f1ec", style="filled", fontsize=13, fontname="Arial Bold", margin="0.22,0.12", penwidth=1.6, width=3.8, height=1.7, fixedsize=true];
  a1 [shape=ellipse, label=<<U>user_id</U>>, fillcolor="#ffffff", style="filled", fontsize=10, margin="0.06,0.03"];
  e_user -- a1 [len=1.15, penwidth=1];
  a2 [shape=ellipse, label=<email>, fillcolor="#ffffff", style="filled", fontsize=10, margin="0.06,0.03"];
  e_user -- a2 [len=1.15, penwidth=1];
  e_role [shape=box, label="Role", fillcolor="#e8f1ec", style="filled", fontsize=13, fontname="Arial Bold", margin="0.22,0.12", penwidth=1.6];
  a3 [shape=ellipse, label=<<U>role_id</U>>, fillcolor="#ffffff", style="filled", fontsize=10, margin="0.06,0.03"];
  e_role -- a3 [len=1.15, penwidth=1];
  e_profile [shape=box, label="Seller Profile", fillcolor="#fbefd9", style="filled", peripheries=2, fontsize=13, fontname="Arial Bold", margin="0.22,0.12", penwidth=1.6];
  a4 [shape=ellipse, label=<<I><U>store_name</U></I>>, fillcolor="#ffffff", style="filled", fontsize=10, margin="0.06,0.03"];
  e_profile -- a4 [len=1.15, penwidth=1];
  e_address [shape=box, label="Address", fillcolor="#e8f1ec", style="filled", fontsize=13, fontname="Arial Bold", margin="0.22,0.12", penwidth=1.6];
  a5 [shape=ellipse, label=<<U>address_id</U>>, fillcolor="#ffffff", style="filled", fontsize=10, margin="0.06,0.03"];
  e_address -- a5 [len=1.15, penwidth=1];
  e_application [shape=box, label="Seller Application", fillcolor="#e8f1ec", style="filled", fontsize=13, fontname="Arial Bold", margin="0.22,0.12", penwidth=1.6];
  a6 [shape=ellipse, label=<<U>application_id</U>>, fillcolor="#ffffff", style="filled", fontsize=10, margin="0.06,0.03"];
  e_application -- a6 [len=1.15, penwidth=1];
  e_everify [shape=box, label="Email Verification", fillcolor="#e8f1ec", style="filled", fontsize=13, fontname="Arial Bold", margin="0.22,0.12", penwidth=1.6];
  a7 [shape=ellipse, label=<<U>token_hash</U>>, fillcolor="#ffffff", style="filled", fontsize=10, margin="0.06,0.03"];
  e_everify -- a7 [len=1.15, penwidth=1];
  e_preset [shape=box, label="Password Reset", fillcolor="#e8f1ec", style="filled", fontsize=13, fontname="Arial Bold", margin="0.22,0.12", penwidth=1.6];
  a8 [shape=ellipse, label=<<U>token_hash</U>>, fillcolor="#ffffff", style="filled", fontsize=10, margin="0.06,0.03"];
  e_preset -- a8 [len=1.15, penwidth=1];
  e_note [shape=box, label="Notification", fillcolor="#e8f1ec", style="filled", fontsize=13, fontname="Arial Bold", margin="0.22,0.12", penwidth=1.6];
  a9 [shape=ellipse, label=<<U>notification_id</U>>, fillcolor="#ffffff", style="filled", fontsize=10, margin="0.06,0.03"];
  e_note -- a9 [len=1.15, penwidth=1];
  e_book [shape=box, label="Book", fillcolor="#e8f1ec", style="filled", fontsize=13, fontname="Arial Bold", margin="0.22,0.12", penwidth=1.6, width=3.8, height=1.7, fixedsize=true];
  a10 [shape=ellipse, label=<<U>book_id</U>>, fillcolor="#ffffff", style="filled", fontsize=10, margin="0.06,0.03"];
  e_book -- a10 [len=1.15, penwidth=1];
  a11 [shape=ellipse, label=<isbn>, fillcolor="#ffffff", style="filled", fontsize=10, margin="0.06,0.03"];
  e_book -- a11 [len=1.15, penwidth=1];
  e_category [shape=box, label="Category", fillcolor="#e8f1ec", style="filled", fontsize=13, fontname="Arial Bold", margin="0.22,0.12", penwidth=1.6];
  a12 [shape=ellipse, label=<<U>category_id</U>>, fillcolor="#ffffff", style="filled", fontsize=10, margin="0.06,0.03"];
  e_category -- a12 [len=1.15, penwidth=1];
  e_author [shape=box, label="Author", fillcolor="#e8f1ec", style="filled", fontsize=13, fontname="Arial Bold", margin="0.22,0.12", penwidth=1.6];
  a13 [shape=ellipse, label=<<U>author_id</U>>, fillcolor="#ffffff", style="filled", fontsize=10, margin="0.06,0.03"];
  e_author -- a13 [len=1.15, penwidth=1];
  e_order [shape=box, label="Order", fillcolor="#e8f1ec", style="filled", fontsize=13, fontname="Arial Bold", margin="0.22,0.12", penwidth=1.6];
  a14 [shape=ellipse, label=<<U>order_id</U>>, fillcolor="#ffffff", style="filled", fontsize=10, margin="0.06,0.03"];
  e_order -- a14 [len=1.15, penwidth=1];
  a15 [shape=ellipse, label=<order_number>, fillcolor="#ffffff", style="filled", fontsize=10, margin="0.06,0.03"];
  e_order -- a15 [len=1.15, penwidth=1];
  e_item [shape=box, label="Order Item", fillcolor="#fbefd9", style="filled", peripheries=2, fontsize=13, fontname="Arial Bold", margin="0.22,0.12", penwidth=1.6];
  a16 [shape=ellipse, label=<<I><U>order_item_id</U></I>>, fillcolor="#ffffff", style="filled", fontsize=10, margin="0.06,0.03"];
  e_item -- a16 [len=1.15, penwidth=1];
  e_payment [shape=box, label="Payment", fillcolor="#fbefd9", style="filled", peripheries=2, fontsize=13, fontname="Arial Bold", margin="0.22,0.12", penwidth=1.6];
  a17 [shape=ellipse, label=<<I><U>payment_id</U></I>>, fillcolor="#ffffff", style="filled", fontsize=10, margin="0.06,0.03"];
  e_payment -- a17 [len=1.15, penwidth=1];
  e_move [shape=box, label="Stock Movement", fillcolor="#e8f1ec", style="filled", fontsize=13, fontname="Arial Bold", margin="0.22,0.12", penwidth=1.6];
  a18 [shape=ellipse, label=<<U>movement_id</U>>, fillcolor="#ffffff", style="filled", fontsize=10, margin="0.06,0.03"];
  e_move -- a18 [len=1.15, penwidth=1];
  e_audit [shape=box, label="Audit Log", fillcolor="#e8f1ec", style="filled", fontsize=13, fontname="Arial Bold", margin="0.22,0.12", penwidth=1.6];
  a19 [shape=ellipse, label=<<U>audit_id</U>>, fillcolor="#ffffff", style="filled", fontsize=10, margin="0.06,0.03"];
  e_audit -- a19 [len=1.15, penwidth=1];
  e_setting [shape=box, label="App Setting", fillcolor="#e8f1ec", style="filled", fontsize=13, fontname="Arial Bold", margin="0.22,0.12", penwidth=1.6];
  a20 [shape=ellipse, label=<<U>setting_key</U>>, fillcolor="#ffffff", style="filled", fontsize=10, margin="0.06,0.03"];
  e_setting -- a20 [len=1.15, penwidth=1];
  mongo [shape=box, style="dashed,filled", fillcolor="#f1e6f5", fontsize=12, fontname="Arial Bold", margin="0.2,0.12", penwidth=1.6, label="MongoDB (NoSQL, linked by book_id and user_id)\nReview, Book View: not part of the relational ER\n(see er-chen-nosql)"];
  mongo -- e_book [style=dashed, len=2.6, label="bookId"]; mongo -- e_user [style=dashed, len=2.6, label="userId"];
  r_hasrole [shape=diamond, label="Has Role", fillcolor="#e2eef5", style=filled, fontsize=11, fontname="Arial Bold", margin="0.04,0.02", penwidth=1.4];
  r_hasrole -- e_user [len=3.4, penwidth=1.3, color="black:white:black", headlabel=<<B>N</B>>, labeldistance=2.6, labelangle=0, fontsize=12, fontname="Arial"];
  r_hasrole -- e_role [len=3.4, penwidth=1.2, color=black, headlabel=<<B>1</B>>, labeldistance=2.6, labelangle=0, fontsize=12, fontname="Arial"];
  r_hasprofile [shape=diamond, label="Has Profile", fillcolor="#e2eef5", style=filled, peripheries=2, fontsize=11, fontname="Arial Bold", margin="0.04,0.02", penwidth=1.4];
  r_hasprofile -- e_user:nw [len=3.4, penwidth=1.2, color=black, headlabel=<<B>1</B>>, labeldistance=2.6, labelangle=0, fontsize=12, fontname="Arial"];
  r_hasprofile -- e_profile [len=3.4, penwidth=1.3, color="black:white:black", headlabel=<<B>1</B>>, labeldistance=2.6, labelangle=0, fontsize=12, fontname="Arial"];
  r_saves [shape=diamond, label="Saves", fillcolor="#e2eef5", style=filled, fontsize=11, fontname="Arial Bold", margin="0.04,0.02", penwidth=1.4];
  r_saves -- e_user [len=3.4, penwidth=1.2, color=black, headlabel=<<B>1</B>>, labeldistance=2.6, labelangle=0, fontsize=12, fontname="Arial"];
  r_saves -- e_address [len=3.4, penwidth=1.3, color="black:white:black", headlabel=<<B>N</B>>, labeldistance=2.6, labelangle=0, fontsize=12, fontname="Arial"];
  r_applies [shape=diamond, label="Applies", fillcolor="#e2eef5", style=filled, fontsize=11, fontname="Arial Bold", margin="0.04,0.02", penwidth=1.4];
  r_applies -- e_user [len=3.4, penwidth=1.2, color=black, headlabel=<<B>1</B>>, labeldistance=2.6, labelangle=0, fontsize=12, fontname="Arial"];
  r_applies -- e_application [len=3.4, penwidth=1.3, color="black:white:black", headlabel=<<B>N</B>>, labeldistance=2.6, labelangle=0, fontsize=12, fontname="Arial"];
  r_decides [shape=diamond, label="Decides", fillcolor="#e2eef5", style=filled, fontsize=11, fontname="Arial Bold", margin="0.04,0.02", penwidth=1.4];
  r_decides -- e_user:w [len=3.4, penwidth=1.2, color=black, headlabel=<<B>1</B><BR/><I>admin</I>>, labeldistance=2.6, labelangle=40, fontsize=12, fontname="Arial"];
  r_decides -- e_application [len=3.4, penwidth=1.2, color=black, headlabel=<<B>N</B>>, labeldistance=2.6, labelangle=0, fontsize=12, fontname="Arial"];
  r_verifies [shape=diamond, label="Verifies Email", fillcolor="#e2eef5", style=filled, fontsize=11, fontname="Arial Bold", margin="0.04,0.02", penwidth=1.4];
  r_verifies -- e_user [len=3.4, penwidth=1.2, color=black, headlabel=<<B>1</B>>, labeldistance=2.6, labelangle=0, fontsize=12, fontname="Arial"];
  r_verifies -- e_everify [len=3.4, penwidth=1.3, color="black:white:black", headlabel=<<B>N</B>>, labeldistance=2.6, labelangle=0, fontsize=12, fontname="Arial"];
  r_resets [shape=diamond, label="Resets Password", fillcolor="#e2eef5", style=filled, fontsize=11, fontname="Arial Bold", margin="0.04,0.02", penwidth=1.4];
  r_resets -- e_user [len=3.4, penwidth=1.2, color=black, headlabel=<<B>1</B>>, labeldistance=2.6, labelangle=0, fontsize=12, fontname="Arial"];
  r_resets -- e_preset [len=3.4, penwidth=1.3, color="black:white:black", headlabel=<<B>N</B>>, labeldistance=2.6, labelangle=0, fontsize=12, fontname="Arial"];
  r_receives [shape=diamond, label="Receives", fillcolor="#e2eef5", style=filled, fontsize=11, fontname="Arial Bold", margin="0.04,0.02", penwidth=1.4];
  r_receives -- e_user [len=3.4, penwidth=1.2, color=black, headlabel=<<B>1</B>>, labeldistance=2.6, labelangle=0, fontsize=12, fontname="Arial"];
  r_receives -- e_note [len=3.4, penwidth=1.3, color="black:white:black", headlabel=<<B>N</B>>, labeldistance=2.6, labelangle=0, fontsize=12, fontname="Arial"];
  r_sells [shape=diamond, label="Sells", fillcolor="#e2eef5", style=filled, fontsize=11, fontname="Arial Bold", margin="0.04,0.02", penwidth=1.4];
  r_sells -- e_user:ne [len=3.4, penwidth=1.2, color=black, headlabel=<<B>1</B>>, labeldistance=2.6, labelangle=0, fontsize=12, fontname="Arial"];
  r_sells -- e_book [len=3.4, penwidth=1.3, color="black:white:black", headlabel=<<B>N</B>>, labeldistance=2.6, labelangle=0, fontsize=12, fontname="Arial"];
  r_belongs [shape=diamond, label="Belongs To", fillcolor="#e2eef5", style=filled, fontsize=11, fontname="Arial Bold", margin="0.04,0.02", penwidth=1.4];
  r_belongs -- e_category [len=3.4, penwidth=1.2, color=black, headlabel=<<B>1</B>>, labeldistance=2.6, labelangle=0, fontsize=12, fontname="Arial"];
  r_belongs -- e_book [len=3.4, penwidth=1.3, color="black:white:black", headlabel=<<B>N</B>>, labeldistance=2.6, labelangle=0, fontsize=12, fontname="Arial"];
  r_parent [shape=diamond, label="Parent Of", fillcolor="#e2eef5", style=filled, fontsize=11, fontname="Arial Bold", margin="0.04,0.02", penwidth=1.4];
  r_parent -- e_category [len=3.4, penwidth=1.2, color=black, headlabel=<<B>1</B><BR/><I>parent</I>>, labeldistance=2.6, labelangle=-50, fontsize=12, fontname="Arial"];
  r_parent -- e_category [len=3.4, penwidth=1.2, color=black, headlabel=<<B>N</B><BR/><I>child</I>>, labeldistance=2.6, labelangle=50, fontsize=12, fontname="Arial"];
