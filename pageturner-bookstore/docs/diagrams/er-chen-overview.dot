  r_wish -- e_book [len=3.4, penwidth=1.2, color=black, headlabel=<<B>N</B>>, labeldistance=2.6, labelangle=0, fontsize=12, fontname="Arial"];
  a24 [shape=ellipse, label=<added_at>, fillcolor="#fffdf8", style="filled", fontsize=10, margin="0.06,0.03"];
  r_wish -- a24 [len=1.0, penwidth=1];
  r_places [shape=diamond, label="Places", fillcolor="#e2eef5", style=filled, fontsize=11, fontname="Arial Bold", margin="0.04,0.02", penwidth=1.4];
  r_places -- e_user [len=3.4, penwidth=1.2, color=black, headlabel=<<B>1</B>>, labeldistance=2.6, labelangle=0, fontsize=12, fontname="Arial"];
