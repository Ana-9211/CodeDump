# Copy to .env  (never commit the real file)

# --- PostgreSQL (SQL database) ---------------------------------------------
# Used ONLY by `npm run db:setup` to create the database, roles and tables (needs a superuser)
DATABASE_ADMIN_URL=postgres://postgres:postgres@127.0.0.1:5432/postgres
DB_NAME=bookstore_dbms
# The web app connects as the low-privilege login role bookstore_app
DATABASE_URL=postgres://bookstore_app:bookstore_app_pw@127.0.0.1:5432/bookstore_dbms
# Optional: set a new password for bookstore_app during setup (then change DATABASE_URL to match)
# APP_DB_PASSWORD=

# --- MongoDB (NoSQL database) ------------------------------------------------
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=bookstore_nosql

# --- Web app -----------------------------------------------------------------
JWT_SECRET=change-me-to-a-long-random-string
